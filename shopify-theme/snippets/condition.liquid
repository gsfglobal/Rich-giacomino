{%- comment -%} Param: product. Reads metafield custom.condizione, then a tag "condizione:..." {%- endcomment -%}
{%- liquid
  assign cond = product.metafields.custom.condizione.value
  if cond == blank
    for tag in product.tags
      if tag contains 'condizione:'
        assign cond = tag | remove: 'condizione:' | strip
      endif
    endfor
  endif
-%}
{{- cond -}}
