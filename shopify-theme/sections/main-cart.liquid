<div class="page-wrap"><div class="wrap" style="max-width:860px">
  <h1>{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post">
      {%- for item in cart.items -%}
        <div class="cart-row">
          {%- if item.image -%}{{ item.image | image_url: width: 180 | image_tag: alt: item.title }}{%- else -%}<span></span>{%- endif -%}
          <div><a href="{{ item.url }}"><b>{{ item.product.title }}</b></a><br><span class="muted">{{ item.variant.title | replace: 'Default Title', '' }}</span>
            <div class="qty"><label class="sr" for="q-{{ item.key }}">{{ 'cart.quantity' | t }}</label><input id="q-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div></div>
          <div>{{ item.final_line_price | money }}</div>
        </div>
      {%- endfor -%}
      <p class="price" style="text-align:right">{{ 'cart.total' | t }}: {{ cart.total_price | money }}</p>
      <div style="display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap">
        <button class="btn btn-ghost" type="submit" name="update">{{ 'cart.update' | t }}</button>
        <button class="btn btn-gold" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
      </div>
    </form>
  {%- else -%}
    <p class="muted">{{ 'cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-gold" style="margin-top:20px">{{ 'sections.all_catalog' | t }}</a>
  {%- endif -%}
</div></div>
{% schema %}
{ "name": "Carrello", "settings": [] }
{% endschema %}
