<div class="page-wrap"><div class="wrap">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
  <div class="grid">
    {%- for article in blog.articles -%}
      <a class="card" href="{{ article.url }}">
        <div class="ph">{%- if article.image -%}{{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{% render 'art', type: 'diamond' %}{%- endif -%}</div>
        <div class="meta"><span class="nm">{{ article.title }}</span><span class="av">{{ article.published_at | date: '%d/%m/%Y' }}</span></div>
      </a>
    {%- endfor -%}
  </div>
  {%- endpaginate -%}
</div></div>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
