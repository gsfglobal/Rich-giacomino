<section class="s" style="padding-top:20px">
  <div class="wrap">
    <div class="s-head reveal">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.title }}</h2></div>
      {%- if settings.tiktok_url != blank -%}<a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener" class="btn btn-ghost">{{ section.settings.link_label }} ↗</a>{%- endif -%}
    </div>
    <div class="reels">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="reel reveal" href="{{ b.url | default: settings.tiktok_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <div class="bg">
            {%- if b.video != blank -%}
              {{ b.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, style: 'width:100%;height:100%;object-fit:cover' }}
            {%- elsif b.image != blank -%}
              {{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover' }}
            {%- else -%}
              <div style="width:100%;height:100%;background:radial-gradient(circle at 50% 30%,color-mix(in srgb,var(--violet) 40%,transparent),transparent 60%),linear-gradient(180deg,#0d0e15,#08090D)"></div>
            {%- endif -%}
          </div>
          {%- if b.video == blank -%}<div class="play"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 3l11 7-11 7Z" fill="#fff"/></svg></div>{%- endif -%}
          <b>{{ b.title }}</b>
          {%- if b.text != blank -%}<small>{{ b.text }}</small>{%- endif -%}
          <span class="ask">{{ section.settings.cta }} ↗</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Video TikTok",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sopratitolo", "default": "@giacominorichdiamonds" },
    { "type": "text", "id": "title", "label": "Titolo", "default": "From TikTok to the Rich World" },
    { "type": "text", "id": "link_label", "label": "Testo link profilo", "default": "Segui su TikTok" },
    { "type": "text", "id": "cta", "label": "Testo sul video", "default": "Guarda su TikTok" }
  ],
  "blocks": [{ "type": "reel", "name": "Video", "settings": [
    { "type": "video", "id": "video", "label": "Video verticale (caricato su Shopify)" },
    { "type": "image_picker", "id": "image", "label": "Copertina (se non c'è il video)" },
    { "type": "text", "id": "title", "label": "Titolo", "default": "Unboxing" },
    { "type": "text", "id": "text", "label": "Testo" },
    { "type": "url", "id": "url", "label": "Link al video TikTok" }
  ]}],
  "presets": [{ "name": "Video TikTok", "blocks": [{ "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" }] }]
}
{% endschema %}
