<section class="s" style="padding-top:50px;padding-bottom:30px">
  <div class="wrap">
    <div class="s-head reveal">
      <div>{%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}<h2>{{ section.settings.title }}</h2></div>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ol class="at-steps" role="list">
      {%- for block in section.blocks -%}
        <li class="at-step reveal" {{ block.shopify_attributes }}>
          <span class="at-n" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.cta_label != blank -%}
      <a href="#crea" class="btn btn-gold" style="margin-top:28px">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Atelier: come funziona",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sopratitolo", "default": "Su misura" },
    { "type": "text", "id": "title", "label": "Titolo", "default": "Come nasce il tuo gioiello" },
    { "type": "textarea", "id": "text", "label": "Testo" },
    { "type": "text", "id": "cta_label", "label": "Pulsante verso il configuratore", "default": "Inizia ora" }
  ],
  "blocks": [{ "type": "step", "name": "Passaggio", "settings": [
    { "type": "text", "id": "title", "label": "Titolo", "default": "Titolo" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Testo" } ] }],
  "presets": [{ "name": "Atelier: come funziona" }]
}
{% endschema %}
